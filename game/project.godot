; Engine configuration file.
; Co-Op Roguelike Deckbuilder — Godot 4.x project.
; See ../CLAUDE.md for the project brief and architecture rules.

config_version=5

[application]

config/name="Co-Op Deckbuilder (prototype)"
config/description="Cooperative roguelike deckbuilder — two players vs a boss."
run/main_scene="res://views/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

; Mobile-ready (CLAUDE.md §5): scalable, anchor-based UI. Never hard-code
; pixel positions for one resolution. canvas_items + expand supports both
; tall/narrow phone and wide monitor aspect ratios.
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="sensor"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
