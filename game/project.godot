; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Co-Op Deckbuilder (prototype)"
config/description="Cooperative roguelike deckbuilder — two players vs a boss."
run/main_scene="res://views/menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"


; Nick, 2026-08-31: "while testing the game my pc started to over heat".
; Nothing in this project capped the framerate, so every screen — including
; a static menu — rendered as fast as the card could manage. That pins a GPU
; at 100% and heats the machine for no benefit whatsoever: nobody can see the
; 900th frame in a second. 60 is the cap; vsync is stated rather than left to
; the default so a driver override cannot quietly turn it off.
run/max_fps=60

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/vsync/vsync_mode=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; Landscape only. The HUD puts the beast above and the hand below with the party
; and the climb gauge on the flanks; rotated into portrait there is nowhere for
; any of it to go, so letting the sensor decide just breaks the game sideways.
window/handheld/orientation="landscape"

[gui]

theme/custom="res://ui/theme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
